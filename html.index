
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Moonnotes ☾</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f8f5fc;color:#3d3249;font-family:Arial,sans-serif}
header{padding:22px;background:#fff;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e8deef}
.logo{font-family:Georgia,serif;font-size:27px;color:#9b78bd}
small{color:#9d91a8}
.layout{display:grid;grid-template-columns:240px minmax(0,1fr);min-height:calc(100vh - 81px)}
aside{padding:24px 15px;background:#f1eaf8;border-right:1px solid #e7dcef}
button{border:0;background:#e6d5f5;color:#674b82;border-radius:10px;padding:10px 15px;cursor:pointer}
button:hover{background:#dcc5f0}
nav button{display:block;width:100%;text-align:left;margin:7px 0;background:transparent}
nav button.active{background:#e4d6f1}
main{padding:35px;max-width:1000px;width:100%;margin:auto}
.hero{padding:38px 25px;text-align:center;border-radius:23px;background:linear-gradient(120deg,#f8dfea,#e9e0fa);margin-bottom:26px}
.hero h1{font-family:Georgia,serif;font-size:39px;margin:10px 0}
.panel{background:#fff;border:1px solid #e9e1ed;border-radius:18px;padding:24px;margin-bottom:20px;box-shadow:0 4px 20px #6850790a}
input,textarea{width:100%;font:inherit;color:#44384f;border:1px solid #e4d9eb;border-radius:10px;padding:12px;background:#fdfbff}
input:focus,textarea:focus{outline:2px solid #c4a8de}
#pageTitle{font-size:28px;font-family:Georgia,serif;border:0}
textarea{min-height:310px;resize:vertical;line-height:1.8;margin-top:15px}
.player{width:100%;height:160px;border:0;margin-top:15px;border-radius:10px}
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
a{color:#8354ae}
footer{font-size:12px;color:#94879c;margin-top:15px}
@media(max-width:650px){.layout{grid-template-columns:1fr}aside{border:0;padding:12px}nav{display:flex;overflow:auto;gap:5px}nav button{min-width:130px}main{padding:16px}.hero h1{font-size:30px}}
</style>
</head>
<body>
<header>
  <div class="logo">☾ moonnotes</div>
  <small>my little universe ♡</small>
</header>
<div class="layout">
<aside>
  <p>✧ MY SPACE</p>
  <button onclick="addPage()">＋ New page</button>
  <nav id="pages"></nav>
  <button onclick="exportNotes()">↓ Backup notes</button>
</aside>
<main>
  <section class="hero">
    <div>✦ ☾ ✦</div>
    <h1>Everything is unfolding for me.</h1>
    <p>A peaceful place for my dreams, thoughts, and manifestations.</p>
  </section>
  <section class="panel">
    <h3>♫ My SoundCloud</h3>
    <p><small>Paste a public SoundCloud playlist or track URL.</small></p>
    <input id="soundUrl" placeholder="https://soundcloud.com/..." aria-label="SoundCloud URL">
    <div class="actions">
      <button onclick="connectMusic()">Connect playlist ♡</button>
      <button onclick="openMusic()">Open in SoundCloud ↗</button>
    </div>
    <div id="music"></div>
    <footer>Some playlists may not permit embedded playback.</footer>
  </section>
  <section class="panel">
    <input id="pageTitle" placeholder="Page title">
    <textarea id="pageText" placeholder="Dear universe...

I am grateful for...
I am becoming...
Everything I desire..."></textarea>
    <footer id="saveStatus">Your words are saved automatically in this browser ♡</footer>
  </section>
</main>
</div>
<script>
const key="moonnotes-journal-v1";
const musicKey="moonnotes-music-v1";
const defaults=[
 {id:1,title:"♡ Love",text:"I deserve love that is mutual, peaceful, and kind."},
 {id:2,title:"✧ Money & abundance",text:"I am learning to make wise financial choices."},
 {id:3,title:"☾ Self-concept",text:"I am worthy, confident, and enough."},
 {id:4,title:"☆ Dream life",text:"I am creating a life that makes me happy."}
];
let pages;
try{
 const stored=JSON.parse(localStorage.getItem(key));
 pages=Array.isArray(stored)&&stored.length?stored:defaults;
}catch{pages=defaults;}
let selected=pages[0].id;
const $=id=>document.getElementById(id);
const persist=()=>localStorage.setItem(key,JSON.stringify(pages));
function render(){
 $("pages").replaceChildren();
 pages.forEach(p=>{
   const b=document.createElement("button");
   b.textContent=p.title;
   b.className=p.id===selected?"active":"";
   b.onclick=()=>{selected=p.id;render()};
   $("pages").append(b);
 });
 const p=pages.find(p=>p.id===selected);
 $("pageTitle").value=p.title;
 $("pageText").value=p.text;
}
function saveEditor(){
 const p=pages.find(p=>p.id===selected);
 p.title=$("pageTitle").value;
 p.text=$("pageText").value;
 persist();
 $("saveStatus").textContent="Saved ♡";
 $("pages").querySelectorAll("button")
   .forEach((b,i)=>b.textContent=pages[i].title||"Untitled");
}
$("pageTitle").addEventListener("input",saveEditor);
$("pageText").addEventListener("input",saveEditor);
function addPage(){
 const p={id:Date.now(),title:"✧ Untitled",text:""};
 pages.push(p);selected=p.id;persist();render();
 $("pageTitle").focus();
}
function exportNotes(){
 const blob=new Blob([JSON.stringify(pages,null,2)],{type:"application/json"});
 const a=document.createElement("a");
 a.href=URL.createObjectURL(blob);
 a.download="moonnotes-backup.json";
 a.click();
 setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function getValidUrl(){
 try{
  const u=new URL($("soundUrl").value.trim());
  if(u.protocol!=="https:" || !["soundcloud.com","www.soundcloud.com","on.soundcloud.com"].includes(u.hostname)) return null;
  return u.href;
 }catch{return null;}
}
function connectMusic(){
 const url=getValidUrl();
 if(!url){alert("Please paste a valid SoundCloud link.");return;}
 localStorage.setItem(musicKey,url);
 const iframe=document.createElement("iframe");
 iframe.className="player";
 iframe.title="SoundCloud playlist";
 iframe.allow="autoplay";
 iframe.referrerPolicy="no-referrer-when-downgrade";
 iframe.src="https://w.soundcloud.com/player/?url="+encodeURIComponent(url)+"&color=%23b28dce&auto_play=false";
 $("music").replaceChildren(iframe);
}
function openMusic(){
 const url=getValidUrl();
 if(!url){alert("Add your SoundCloud link first.");return;}
 window.open(url,"_blank","noopener,noreferrer");
}
$("soundUrl").value=localStorage.getItem(musicKey)||"";
render();
if($("soundUrl").value)connectMusic();
</script>
</body>
</html>
